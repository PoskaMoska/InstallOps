# API Config
PROJECT_NAME="InstallOps API"
ENVIRONMENT="development"
TIMEZONE="Europe/Kyiv"

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/installops"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="installops"

# Telegram
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_ADMIN_CHAT_ID="your-chat-id"

# Google Sheets
GOOGLE_SPREADSHEET_ID="your-spreadsheet-id"
GOOGLE_SERVICE_ACCOUNT_FILE="credentials.json"

# External API
EXTERNAL_API_URL="https://api.crm.example.com"
EXTERNAL_API_TOKEN="your-api-token"
WEBHOOK_SECRET="your-webhook-secret"

# App Settings
SYNC_INTERVAL_MINUTES=15
MIN_INSTALLATIONS_FOR_RANKING=10
EMPLOYEE_POSTPONEMENT_ALERT_THRESHOLD=3
